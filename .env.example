# Local machine: npm run local
# Then in a second terminal: npm run simulate
# That uses a SQLite file, an in-process queue, and disk images.
# Leave the service keys empty unless you want the real APIs.

# Machine testing only. The VPS install writes its own .env with LOCAL_DEV=false.
LOCAL_DEV=true
PORT=3000
DATABASE_URL=file:../data/autopost.db
REDIS_URL=
PUBLIC_BASE_URL=http://127.0.0.1:3000
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_API_KEY=local-admin

ALLOWLIST_PHONES=15551230000

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=local-secret
WHATSAPP_VERIFY_TOKEN=local-verify
GRAPH_API_VERSION=v21.0

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# One-time connect, only after CANVA_CLIENT_ID is set:
# http://127.0.0.1:3000/integrations/canva?key=local-admin
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:3000/integrations/canva/callback
CANVA_FIELD_HEADLINE=HEADLINE
CANVA_FIELD_CAPTION=CAPTION
CANVA_FIELD_CTA=CTA

AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=post-images
STORAGE_DIR=storage

BRAND_NAME=Smile Dental
BRAND_TONE=Warm, professional, and reassuring
BRAND_AUDIENCE=Adults 25-50
CANVA_BRAND_TEMPLATE_ID=
FB_PAGE_ID=
IG_USER_ID=
PAGE_ACCESS_TOKEN=
